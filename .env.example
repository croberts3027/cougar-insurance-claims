# Copy this file to `.env` and replace the values with the ones your instructor gives you.
#   PowerShell:  Copy-Item .env.example .env
#   bash / zsh:  cp .env.example .env
#
# `.env` is gitignored. NEVER commit it, paste it into a chat or issue, or share it.
# These are standard PostgreSQL (libpq) variables, so Python, R and psql all read them.

PGHOST=ep-example-123456.us-east-2.aws.neon.tech
PGDATABASE=neondb
PGUSER=student_ro
PGPASSWORD=ask-your-instructor
PGSSLMODE=require
