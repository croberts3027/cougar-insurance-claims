# --- Secrets: never commit ---
.env
.env.*
!.env.example

# --- Data and large files: the data lives in Neon, not in git ---
# Use `git add -f <file>` only for a small file you really mean to share.
data/raw/*
data/interim/*
data/processed/*
!data/*/.gitkeep
models/*
!models/.gitkeep
*.csv
*.parquet
*.feather
*.duckdb

# --- Local copy of the generated CSVs (instructor machine only) ---
/synthetic_20k_v2/

# --- Python ---
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# --- R ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata
renv/library/
renv/staging/

# --- Quarto / rendered output ---
_site/
.quarto/
*_files/
*_cache/

# --- Claude Code: keep shared config, ignore personal and tool state ---
**/.claude/settings.local.json
**/.claude/autoharness/
CLAUDE.local.md

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/

/.quarto/
**/*.quarto_ipynb
