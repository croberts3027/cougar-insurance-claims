{
  "outputStyle": "tutor",
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(Rscript:*)",
      "Bash(quarto:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
